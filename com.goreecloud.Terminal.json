{
  "app-id": "com.goreecloud.Terminal",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "goreecloud-terminal",
  "finish-args": [
    "--allow=devel",
    "--device=dri",
    "--filesystem=host",
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/cmake",
    "/share/gir-1.0",
    "/share/vala",
    "/share/man",
    "/bin/vte-2.91-gtk4",
    "/libexec/vte-urlencode-cwd",
    "/etc"
  ],
  "modules": [
    {
      "name": "libportal",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dbackend-gtk3=disabled",
        "-Dbackend-gtk4=enabled",
        "-Dbackend-qt5=disabled",
        "-Dbackend-qt6=disabled",
        "-Ddocs=false",
        "-Dportal-tests=false",
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/flatpak/libportal/releases/download/0.9.1/libportal-0.9.1.tar.xz",
          "sha256": "de801ee349ed3c255a9af3c01b1a401fab5b3fc1c35eb2fd7dfb35d4b8194d7f"
        }
      ]
    },
    {
      "name": "fast_float",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/fastfloat/fast_float.git",
          "tag": "v8.2.5",
          "commit": "05087a303dad9c98768b33c829d398223a649bc6"
        }
      ]
    },
    {
      "name": "simdutf",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/simdutf/simdutf.git",
          "tag": "v9.0.0",
          "commit": "ca7acbcea967b5dcbab490066e99e3a6e6925539"
        }
      ]
    },
    {
      "name": "vte",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dgir=false",
        "-Dglade=false",
        "-Dgtk3=false",
        "-Dgtk4=true",
        "-Dvapi=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/vte/0.84/vte-0.84.0.tar.xz",
          "sha256": "0414e31583836aeb7878da25f67c515f7e8879917ecc37c92e26b83e8d8fc3e3"
        }
      ]
    },
    {
      "name": "goreecloud-terminal",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "--buildtype=release",
        "--libdir=lib",
        "--wrap-mode=nodownload",
        "-Ddevelopment=false",
        "-Dlibc-compat=true"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
