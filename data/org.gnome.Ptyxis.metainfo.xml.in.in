<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>@APP_NAME@</name>
  <summary>Secure terminal for the GoreeCloud platform</summary>
  <description>
    <p>
      GoreeCloud Terminal is the native terminal experience for GoreeCloud,
      designed for local shells, SSH administration, development workflows,
      containers, and infrastructure operations.
    </p>
    <p>Features:</p>
    <ul>
      <li>Local shell and remote SSH administration workflows</li>
      <li>Container awareness with support for Podman, Toolbox, Distrobox, and more</li>
      <li>Configurable keyboard shortcuts and reusable profiles</li>
      <li>Modern interface designed to integrate with the GoreeCloud Glaze UI design language</li>
      <li>User-installable color palettes with light and dark variants</li>
      <li>Tabbed workflows with tab overviews, pinned tabs, and saved sessions</li>
      <li>Foreground process tracking for sudo and SSH sessions</li>
      <li>Transparent terminal background support</li>
      <li>Separate process mode for terminal-based applications</li>
      <li>Terminal tabs isolated in separate cgroups</li>
      <li>Terminal inspector for application development and diagnostics</li>
    </ul>
    <p>
      GoreeCloud Terminal is maintained by GoreeCloud and is based on the
      open-source Ptyxis terminal project. Upstream copyright, licensing,
      and attribution are preserved in accordance with their respective terms.
    </p>
  </description>
  <developer id="com.goreecloud">
    <name translate="no">GoreeCloud</name>
  </developer>
  <url type="homepage">https://github.com/GoreeCloud/goreecloud-terminal</url>
  <url type="bugtracker">https://github.com/GoreeCloud/goreecloud-terminal/issues</url>
  <url type="vcs-browser">https://github.com/GoreeCloud/goreecloud-terminal</url>

  <translation type="gettext">ptyxis</translation>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <releases>
    <release version="50.2" date="2026-08-20">
      <description>
        <p>Initial GoreeCloud-maintained identity and platform integration release.</p>
      </description>
    </release>
    <release version="50.1" date="2026-03-16"/>
    <release version="50.0" date="2026-03-16"/>
    <release version="49.0" date="2025-09-12"/>
  </releases>

  <content_rating type="oars-1.1" />
</component>
