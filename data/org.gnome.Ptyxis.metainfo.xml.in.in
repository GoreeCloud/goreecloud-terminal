<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>@APP_NAME@</name>
  <summary>GoreeCloud-maintained terminal for Linux workstations</summary>
  <description>
    <p>
      GoreeCloud Terminal is the GoreeCloud-maintained fork of Ptyxis for approved
      GoreeCloud Linux workstations. It preserves the mature GTK, VTE, PTY,
      container, accessibility, and terminal-emulation foundation inherited from
      upstream Ptyxis while adding GoreeCloud-owned product identity, Glaze UI,
      Wardveil Security context presentation, and GoreeCloud terminal workflows.
    </p>
    <p>
      The project remains an open-source maintained fork. Upstream Ptyxis authorship,
      copyright, licensing, translation history, and source provenance are preserved
      in the repository and are not represented as original GoreeCloud work.
    </p>
    <p>Current capabilities include:</p>
    <ul>
      <li>Container-aware terminal sessions with Podman, Toolbox, Distrobox, and related environments</li>
      <li>Configurable keyboard shortcuts, profiles, palettes, tabs, and saved sessions</li>
      <li>Glaze UI application chrome while preserving VTE terminal palette ownership</li>
      <li>Wardveil session-context presentation for remote, container, and elevated states</li>
      <li>Terminal context-menu utilities with normal shell and sudo authorization boundaries</li>
      <li>Foreground-process tracking, transparent terminal backgrounds, and terminal inspection tools</li>
    </ul>
  </description>
  <project_group>GoreeCloud</project_group>
  <!-- developer_name is retained for compatibility with older AppStream consumers. -->
  <developer_name translate="no">GoreeCloud</developer_name>
  <developer id="com.goreecloud">
    <name translate="no">GoreeCloud</name>
  </developer>
  <url type="homepage">https://github.com/GoreeCloud/goreecloud-terminal</url>
  <url type="bugtracker">https://github.com/GoreeCloud/goreecloud-terminal/issues</url>
  <url type="vcs-browser">https://github.com/GoreeCloud/goreecloud-terminal</url>
  <url type="translate">https://gitlab.gnome.org/chergert/ptyxis/-/tree/main/po</url>

  <!-- The fork continues to consume the inherited Ptyxis gettext catalog. -->
  <translation type="gettext">ptyxis</translation>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <provides>
    <binary>ptyxis</binary>
  </provides>

  <content_rating type="oars-1.1" />
</component>
