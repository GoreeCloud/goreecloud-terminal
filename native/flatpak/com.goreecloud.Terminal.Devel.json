{
  "app-id": "com.goreecloud.Terminal.Devel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "goreecloud-terminal",
  "finish-args": [
    "--allow=devel",
    "--device=dri",
    "--filesystem=xdg-run/goreecloud-terminal",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland"
  ],
  "cleanup": [
    "/bin/vte-2.91-gtk4",
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/doc",
    "/share/gir-1.0",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "/share/vala",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "fast_float",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/fastfloat/fast_float.git",
          "tag": "v8.2.5",
          "commit": "05087a303dad9c98768b33c829d398223a649bc6"
        }
      ]
    },
    {
      "name": "simdutf",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/simdutf/simdutf.git",
          "tag": "v9.0.0",
          "commit": "ca7acbcea967b5dcbab490066e99e3a6e6925539"
        }
      ]
    },
    {
      "name": "vte",
      "buildsystem": "meson",
      "config-opts": [
        "--buildtype=release",
        "--libdir=lib",
        "-Dgtk3=false",
        "-Dgtk4=true",
        "-Dglade=false",
        "-Dgir=false",
        "-Dvapi=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/vte/0.84/vte-0.84.0.tar.xz",
          "sha256": "0414e31583836aeb7878da25f67c515f7e8879917ecc37c92e26b83e8d8fc3e3"
        }
      ]
    },
    {
      "name": "goreecloud-terminal-native",
      "buildsystem": "simple",
      "build-commands": [
        "meson setup _native-build native --buildtype=debugoptimized --prefix=/app -Dproduct_identity=development",
        "meson compile -C _native-build",
        "meson test -C _native-build --print-errorlogs",
        "meson install -C _native-build",
        "test -x /app/bin/goreecloud-terminal",
        "test -f /app/share/applications/com.goreecloud.Terminal.Devel.desktop",
        "test -f /app/share/metainfo/com.goreecloud.Terminal.Devel.metainfo.xml",
        "test -f /app/share/icons/hicolor/scalable/apps/com.goreecloud.Terminal.Devel.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
