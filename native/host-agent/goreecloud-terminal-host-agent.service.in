[Unit]
Description=GoreeCloud Terminal host-session agent
Documentation=https://github.com/GoreeCloud/goreecloud-terminal

[Service]
Type=simple
ExecStart=@HOST_AGENT_PATH@
Restart=on-failure
RestartSec=2s

# Keep this unit intentionally free of systemd execution sandboxing. The host
# agent spawns the user's interactive host shell, so service-level execution
# restrictions would be inherited by that shell and change normal host
# semantics. Security is enforced by the private runtime socket, same-user
# peer authentication, bounded protocol, and host-side request validation.

[Install]
WantedBy=default.target
