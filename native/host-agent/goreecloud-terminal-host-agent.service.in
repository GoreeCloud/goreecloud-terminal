[Unit]
Description=GoreeCloud Terminal host-session agent
Documentation=https://github.com/GoreeCloud/goreecloud-terminal

[Service]
Type=simple
ExecStart=@HOST_AGENT_PATH@
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
