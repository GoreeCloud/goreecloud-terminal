<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <!--
    Read-only compatibility schemas for the transitional GoreeCloud Terminal
    data paths. The schema IDs are native-migration-specific so they never
    collide with the transitional application's installed schemas.
  -->
  <schema id="com.goreecloud.Terminal.Migration.LegacyRoot">
    <key name="default-profile-uuid" type="s">
      <default>''</default>
    </key>
    <key name="profile-uuids" type="as">
      <default>[]</default>
    </key>
    <key name="audible-bell" type="b">
      <default>true</default>
    </key>
  </schema>

  <schema id="com.goreecloud.Terminal.Migration.LegacyProfile">
    <key name="label" type="s">
      <default>''</default>
    </key>
    <key name="limit-scrollback" type="b">
      <default>true</default>
    </key>
    <key name="scrollback-lines" type="i">
      <default>10000</default>
      <range min="0" max="2147483647"/>
    </key>
    <key name="use-custom-command" type="b">
      <default>false</default>
    </key>
  </schema>
</schemalist>
